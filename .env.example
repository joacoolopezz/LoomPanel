GP_DATA_DIR=/opt/loompanel/data
GP_GAME=minecraft
GP_SETUP_TOKEN=change-me
GP_MAX_RAM_MB=4096
GP_MAX_CPUS=2
GP_MAX_DISK_GB=40
GP_PORT=8080
GP_BIND=0.0.0.0
GP_TRUST_PROXY=0
GP_LANG=es   # language of notification messages: es or en
TZ=UTC   # scheduled tasks run on this time zone, e.g. America/Santiago
